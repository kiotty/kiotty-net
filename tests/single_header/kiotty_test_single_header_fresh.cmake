function(body_of path result)
    file(READ "${path}" text)
    string(REPLACE "\r\n" "\n" text "${text}")
    string(FIND "${text}" "*/" stamp_end)
    if(stamp_end EQUAL -1)
        message(FATAL_ERROR "${path} has no generated header comment")
    endif()
    math(EXPR body_start "${stamp_end} + 2")
    string(SUBSTRING "${text}" ${body_start} -1 body)
    set(${result} "${body}" PARENT_SCOPE)
endfunction()

body_of("${COMMITTED}" committed)
body_of("${GENERATED}" generated)
if(NOT committed STREQUAL generated)
    message(FATAL_ERROR "${COMMITTED} is stale: run python3 tools/make_single_header.py")
endif()
