file(READ "${HEADER}" text)
string(REGEX MATCHALL "[A-Za-z0-9_]*[Kk][Ii][Oo][Tt][Tt][Yy][A-Za-z0-9_]*" leftovers "${text}")
if(leftovers)
    list(REMOVE_DUPLICATES leftovers)
    message(FATAL_ERROR "${HEADER} still has kiotty names: ${leftovers}")
endif()
foreach(expected AcmeLink_HttpClient AcmeLinkCode ACME_LINK_IMPLEMENTATION "namespace acme")
    string(FIND "${text}" "${expected}" found)
    if(found EQUAL -1)
        message(FATAL_ERROR "${HEADER} has no ${expected}")
    endif()
endforeach()
